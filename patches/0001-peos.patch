diff --git a/src/engine/system.cpp b/src/engine/system.cpp
index e3d7171..7184199 100644
--- a/src/engine/system.cpp
+++ b/src/engine/system.cpp
@@ -450,7 +450,59 @@ bool System::IsDirectory( const std::string_view path )
 
 bool System::GetCaseInsensitivePath( const std::string_view path, std::string & correctedPath )
 {
-#if !defined( _WIN32 ) && !defined( ANDROID ) && !defined( TARGET_PS_VITA ) && !defined( __IPHONEOS__ )
+#if defined( __peos__ )
+    // PeOS: an app may read only the folders its app.ini grants (say
+    // /starlight/config), not "/" nor "/starlight": the walk starts from the
+    // longest leading part of the path that opens as it is, and only the
+    // parts after it are looked for whatever their case (DATA or data).
+    correctedPath.clear();
+    if ( path.empty() ) {
+        return false;
+    }
+    const std::string full( path );
+    std::string head = full;
+    std::unique_ptr<DIR, int ( * )( DIR * )> dir( nullptr, closedir );
+    for ( ;; ) {
+        if ( head.empty() ) {
+            head = full.front() == '/' ? "/" : ".";
+        }
+        dir.reset( opendir( head.c_str() ) );
+        if ( dir || head == "/" || head == "." ) {
+            break;
+        }
+        const size_t slash = head.find_last_of( '/' );
+        head = slash == std::string::npos ? std::string() : head.substr( 0, slash );
+    }
+    if ( !dir ) {
+        // Nothing of it opens: the path as it is, if it is a file there
+        correctedPath = full;
+        return true;
+    }
+    correctedPath = ( head == "." && full.front() != '.' ) ? std::string() : head;
+    const std::string rest = full.size() > head.size() && head != "." ? full.substr( head.size() ) : ( head == "." ? full : std::string() );
+    for ( const std::filesystem::path & pathItem : std::filesystem::path{ rest } ) {
+        const std::string item = pathItem.string();
+        if ( item.empty() || item == "/" ) {
+            continue;
+        }
+        if ( !dir ) {
+            return false;
+        }
+        const struct dirent * entry = readdir( dir.get() );
+        while ( entry != nullptr && strcasecmp( item.c_str(), entry->d_name ) != 0 ) {
+            entry = readdir( dir.get() );
+        }
+        if ( entry == nullptr ) {
+            return false;
+        }
+        if ( !correctedPath.empty() && correctedPath.back() != '/' ) {
+            correctedPath += '/';
+        }
+        correctedPath += entry->d_name;
+        dir.reset( opendir( correctedPath.c_str() ) );
+    }
+    return !correctedPath.empty();
+#elif !defined( _WIN32 ) && !defined( ANDROID ) && !defined( TARGET_PS_VITA ) && !defined( __IPHONEOS__ )
     // The following code is based on https://github.com/OneSadCookie/fcaseopen and assumes the use of POSIX IEEE Std 1003.1-2001 pathnames
     correctedPath.clear();
 
diff --git a/src/fheroes2/game/game_init.cpp b/src/fheroes2/game/game_init.cpp
index c497a30..f5e6e19 100644
--- a/src/fheroes2/game/game_init.cpp
+++ b/src/fheroes2/game/game_init.cpp
@@ -55,6 +55,137 @@
 #include "version.h"
 #include "zzlib.h"
 
+#if defined( __peos__ )
+#include <filesystem>
+#include <system_error>
+
+#include <strings.h>
+
+namespace
+{
+    // PeOS: the user's game (the full one or the demo) is copied once from a
+    // USB stick or /home into the app's folder, /starlight/config/fheroes2
+    // (docs/game-ports-plan.md, fheroes2 phase 4). HEROES2.AGG goes last,
+    // under a provisional name: a copy cut short is made again next time.
+    namespace fs = std::filesystem;
+
+    fs::path childNoCase( const fs::path & dir, const std::string_view name )
+    {
+        std::error_code ec;
+        for ( const fs::directory_entry & entry : fs::directory_iterator( dir, ec ) ) {
+            const std::string entryName = entry.path().filename().string();
+            if ( entryName.size() == name.size() && strncasecmp( entryName.c_str(), name.data(), name.size() ) == 0 ) {
+                return entry.path();
+            }
+        }
+        return {};
+    }
+
+    bool hasGame( const fs::path & dir )
+    {
+        const fs::path data = childNoCase( dir, "data" );
+        std::error_code ec;
+        return !data.empty() && fs::is_directory( data, ec ) && !childNoCase( data, "heroes2.agg" ).empty();
+    }
+
+    // A folder with DATA/HEROES2.AGG: the place itself, or a folder in it, or one more down
+    fs::path findGame( const fs::path & place, const int depth )
+    {
+        std::error_code ec;
+        if ( !fs::is_directory( place, ec ) ) {
+            return {};
+        }
+        if ( hasGame( place ) ) {
+            return place;
+        }
+        if ( depth == 0 ) {
+            return {};
+        }
+        for ( const fs::directory_entry & entry : fs::directory_iterator( place, ec ) ) {
+            if ( entry.is_directory( ec ) ) {
+                if ( fs::path found = findGame( entry.path(), depth - 1 ); !found.empty() ) {
+                    return found;
+                }
+            }
+        }
+        return {};
+    }
+
+    bool copyTree( const fs::path & from, const fs::path & to, const fs::path & last, uint64_t & bytes )
+    {
+        std::error_code ec;
+        fs::create_directories( to, ec );
+        for ( const fs::directory_entry & entry : fs::directory_iterator( from, ec ) ) {
+            const fs::path target = to / entry.path().filename();
+            if ( entry.is_directory( ec ) ) {
+                if ( !copyTree( entry.path(), target, last, bytes ) ) {
+                    return false;
+                }
+            }
+            else if ( entry.is_regular_file( ec ) && entry.path() != last ) {
+                if ( !fs::copy_file( entry.path(), target, fs::copy_options::overwrite_existing, ec ) ) {
+                    ERROR_LOG( "fheroes2-setup: " << entry.path().string() << " not copied: " << ec.message() )
+                    return false;
+                }
+                bytes += entry.file_size( ec );
+            }
+        }
+        return true;
+    }
+
+    void copyUserGame()
+    {
+        const fs::path dest = System::GetDataDirectory( "fheroes2" );
+        if ( dest.empty() || hasGame( dest ) ) {
+            return;
+        }
+
+        fs::path source;
+        for ( const char * place : { "/media1", "/media2", "/media3", "/media4", "/home" } ) {
+            source = findGame( place, 2 );
+            if ( !source.empty() ) {
+                break;
+            }
+        }
+        if ( source.empty() ) {
+            COUT( "fheroes2-setup: no DATA/HEROES2.AGG on the USB sticks nor in /home" )
+            return;
+        }
+
+        COUT( "fheroes2-setup: found the game in " << source.string() << ", copying it to " << dest.string() )
+        const fs::path agg = childNoCase( childNoCase( source, "data" ), "heroes2.agg" );
+        uint64_t bytes = 0;
+        for ( const std::string_view part : { "data", "maps", "music", "anim" } ) {
+            const fs::path from = childNoCase( source, part );
+            std::error_code ec;
+            if ( from.empty() || !fs::is_directory( from, ec ) ) {
+                continue;
+            }
+            if ( !copyTree( from, dest / from.filename(), agg, bytes ) ) {
+                return;
+            }
+        }
+
+        // The game's main file last, so it is there only when the rest is
+        std::error_code ec;
+        const fs::path aggTarget = dest / agg.parent_path().filename() / agg.filename();
+        fs::path partial = aggTarget;
+        partial += ".part";
+        if ( !fs::copy_file( agg, partial, fs::copy_options::overwrite_existing, ec ) ) {
+            ERROR_LOG( "fheroes2-setup: " << agg.string() << " not copied: " << ec.message() )
+            return;
+        }
+        fs::rename( partial, aggTarget, ec );
+        if ( ec ) {
+            ERROR_LOG( "fheroes2-setup: " << aggTarget.string() << " not renamed: " << ec.message() )
+            return;
+        }
+        bytes += fs::file_size( aggTarget, ec );
+        COUT( "fheroes2-setup: copied " << bytes / 1024 << " KB" )
+    }
+}
+#endif
+
 namespace fheroes2
 {
     class Image;
