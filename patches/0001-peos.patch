             try {
+#if defined( __peos__ )
+                copyUserGame();
+#endif
                 _aggInitializer = std::make_unique<AGG::AGGInitializer>();
 
                 _h2dInitializer = std::make_unique<fheroes2::h2d::H2DInitializer>();
